# Copy to .env and fill in your own keys. .env is gitignored; this file is not.

# --- SEC identification (recommended for anyone running this at volume) ------
# SEC requires a declared, contactable User-Agent on every request. Unset, the
# module identifies itself with the project URL, which is contactable and fine
# for light use. Set your own address if you are making sustained requests --
# SEC's record of who is hitting them should point at you, not the project.
ATRADE_SEC_CONTACT=

# Only `atrade portfolio` reads these. The other ten tools work without them.
# Install the extra first:  pip install 'aethelark-trade[portfolio]'
#
# Keys come from https://app.alpaca.markets/ — paper trading keys are fine and
# are what the base URL below selects. `portfolio` only ever reads: it calls
# get_account() and get_all_positions() and places no orders.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional. Absent, Layer 3 scores news tone with the keyless lexicon instead
# of the vendor signal; see aethelark_trade/engine/layers/news_velocity.py.
FINNHUB_API_KEY=
